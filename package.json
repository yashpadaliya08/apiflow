{
  "name": "apiflow-studio",
  "version": "1.0.0",
  "description": "Standalone API Testing Studio & Synthetic Mock Runner",
  "main": "backend/server.js",
  "scripts": {
    "test": "node --test",
    "check": "node frontend/node_modules/typescript/bin/tsc --project frontend/tsconfig.json --noEmit && node --check backend/server.js",
    "build": "npm --prefix frontend run build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local backend/server.js",
    "dev:backend": "node --env-file-if-exists=.env --env-file-if-exists=.env.local backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix frontend install --include=dev && npm --prefix backend install"
  },
  "keywords": [
    "api",
    "testing",
    "mock",
    "faker",
    "synthetic",
    "openapi",
    "postman"
  ],
  "author": "Yash Padaliya",
  "license": "MIT",
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11"
  }
}
