PORT=5000
NODE_ENV=production
ADMIN_KEY=change_me_to_a_secure_admin_key
ALLOWED_PROXY_DOMAINS=*
# Exact browser-visible origin (required behind HTTPS ingress for admin login).
PUBLIC_ORIGIN=https://your-app.example.com
# Comma-separated trusted ingress IPs/CIDRs only. Empty trusts no forwarded headers.
TRUSTED_PROXY_CIDRS=
